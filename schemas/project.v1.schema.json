{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://motion.kamirtyai.com/schemas/project.v1.schema.json",
  "title": "Kamirty Motion Project V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "title", "locale", "fps", "durationFrames", "size", "theme", "scenes"],
  "properties": {
    "version": {"const": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 140},
    "locale": {"const": "ar"},
    "fps": {"const": 30},
    "durationFrames": {"const": 3600},
    "size": {
      "type": "object", "required": ["width", "height"], "additionalProperties": false,
      "properties": {"width": {"type": "integer", "minimum": 480, "maximum": 1920}, "height": {"type": "integer", "minimum": 480, "maximum": 1920}}
    },
    "theme": {
      "type": "object", "required": ["background", "foreground", "accent"], "additionalProperties": false,
      "properties": {
        "background": {"$ref": "#/$defs/color"},
        "foreground": {"$ref": "#/$defs/color"},
        "accent": {"$ref": "#/$defs/color"}
      }
    },
    "scenes": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {"$ref": "#/$defs/scene"}
    }
  },
  "$defs": {
    "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
    "scene": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "startFrame", "durationFrames", "title", "items", "icon"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,40}$"},
        "kind": {"enum": ["hero", "steps", "comparison", "stat", "timeline", "quote", "summary", "outro"]},
        "startFrame": {"type": "integer", "minimum": 0, "maximum": 3599},
        "durationFrames": {"type": "integer", "minimum": 1, "maximum": 3600},
        "title": {"type": "string", "maxLength": 160},
        "items": {"type": "array", "maxItems": 6, "items": {"type": "string", "maxLength": 160}},
        "icon": {"type": "string", "minLength": 1, "maxLength": 60}
      }
    }
  }
}
