{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://motion.kamirtyai.com/schemas/project.v1.schema.json",
  "title": "Kamirty Motion Project V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "title",
    "locale",
    "fps",
    "durationFrames",
    "size",
    "theme",
    "scenes"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140
    },
    "locale": {
      "const": "ar"
    },
    "fps": {
      "const": 30
    },
    "durationFrames": {
      "const": 3600
    },
    "size": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 480,
          "maximum": 1920
        },
        "height": {
          "type": "integer",
          "minimum": 480,
          "maximum": 1920
        }
      }
    },
    "theme": {
      "type": "object",
      "required": [
        "background",
        "foreground",
        "accent"
      ],
      "additionalProperties": false,
      "properties": {
        "background": {
          "$ref": "#/$defs/color"
        },
        "foreground": {
          "$ref": "#/$defs/color"
        },
        "accent": {
          "$ref": "#/$defs/color"
        },
        "accent2": {
          "$ref": "#/$defs/color"
        },
        "surface": {
          "$ref": "#/$defs/color"
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/scene"
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional presentation settings (added in v1.1, backward compatible).",
      "properties": {
        "preset": {
          "type": "string",
          "maxLength": 40
        },
        "font": {
          "type": "string",
          "maxLength": 40
        },
        "digits": {
          "enum": [
            "arabic",
            "latin"
          ]
        },
        "transition": {
          "enum": [
            "fade",
            "slide",
            "zoom",
            "wipe"
          ]
        },
        "background": {
          "enum": [
            "gradient",
            "dots",
            "waves",
            "plain"
          ]
        },
        "music": {
          "enum": [
            "none",
            "calm",
            "bright",
            "epic"
          ]
        },
        "watermark": {
          "type": "boolean",
          "description": "Deprecated and ignored: videos never carry a site mark."
        },
        "sfx": {
          "type": "boolean",
          "description": "Automatic sound effects when elements appear."
        },
        "pace": {
          "enum": [
            "calm",
            "balanced",
            "fast"
          ]
        }
      }
    },
    "assets": {
      "type": "object",
      "description": "Pictures embedded by 'save' so the file is self-contained: asset id → data URL.",
      "propertyNames": {
        "pattern": "^[0-9a-f]{24}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^data:image/(png|jpeg|webp);base64,",
        "maxLength": 8388608
      },
      "maxProperties": 40
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "startFrame",
        "durationFrames",
        "title",
        "items",
        "icon"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,40}$"
        },
        "kind": {
          "enum": [
            "hero",
            "steps",
            "comparison",
            "stat",
            "timeline",
            "quote",
            "summary",
            "outro",
            "kpis",
            "donut",
            "columns",
            "pictogram",
            "cycle",
            "pyramid",
            "proscons",
            "checklist",
            "quiz",
            "definition",
            "chapter",
            "tip"
          ]
        },
        "startFrame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3599
        },
        "durationFrames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "title": {
          "type": "string",
          "maxLength": 160
        },
        "items": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string",
            "maxLength": 160
          }
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "image": {
          "$ref": "#/$defs/image"
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "x",
        "y",
        "scale",
        "rotation",
        "shape",
        "border",
        "shadow",
        "opacity",
        "entrance",
        "layer"
      ],
      "properties": {
        "assetId": {
          "type": "string",
          "pattern": "^[0-9a-f]{24}$"
        },
        "x": {
          "type": "number",
          "minimum": -0.5,
          "maximum": 1.5
        },
        "y": {
          "type": "number",
          "minimum": -0.5,
          "maximum": 1.5
        },
        "scale": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1.5
        },
        "rotation": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "shape": {
          "enum": [
            "rect",
            "rounded",
            "circle"
          ]
        },
        "border": {
          "type": "boolean"
        },
        "shadow": {
          "type": "boolean"
        },
        "opacity": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 1
        },
        "entrance": {
          "enum": [
            "fade",
            "zoom",
            "slide",
            "none"
          ]
        },
        "layer": {
          "enum": [
            "front",
            "back"
          ]
        }
      }
    }
  }
}
